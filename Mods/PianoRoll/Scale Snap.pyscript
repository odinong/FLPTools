# FLPTools mod pack
"""Moves every out-of-key note onto the chosen scale."""
import flpianoroll as flp

KEYS = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
SCALES = [
    ('Major', [0, 2, 4, 5, 7, 9, 11]), ('Natural minor', [0, 2, 3, 5, 7, 8, 10]),
    ('Harmonic minor', [0, 2, 3, 5, 7, 8, 11]), ('Melodic minor', [0, 2, 3, 5, 7, 9, 11]),
    ('Dorian', [0, 2, 3, 5, 7, 9, 10]), ('Phrygian', [0, 1, 3, 5, 7, 8, 10]),
    ('Lydian', [0, 2, 4, 6, 7, 9, 11]), ('Mixolydian', [0, 2, 4, 5, 7, 9, 10]),
    ('Locrian', [0, 1, 3, 5, 6, 8, 10]), ('Major pentatonic', [0, 2, 4, 7, 9]),
    ('Minor pentatonic', [0, 3, 5, 7, 10]), ('Blues', [0, 3, 5, 6, 7, 10]),
    ('Phrygian dominant', [0, 1, 4, 5, 7, 8, 10]), ('Hungarian minor', [0, 2, 3, 6, 7, 8, 11]),
]


def createDialog():
    form = flp.ScriptDialog("Scale Snap", "Moves notes that are outside the scale to the nearest scale note.")
    form.AddInputCombo('Key', KEYS, 0)
    form.AddInputCombo('Scale', [s[0] for s in SCALES], 1)
    form.AddInputCombo('Direction', ['Nearest', 'Up', 'Down'], 0)
    return form


def apply(form):
    key = form.GetInputValue('Key')
    scale = [(key + d) % 12 for d in SCALES[form.GetInputValue('Scale')][1]]
    direction = form.GetInputValue('Direction')
    for i in range(flp.score.noteCount):
        note = flp.score.getNote(i)
        n = note.number
        if n % 12 in scale:
            continue
        up = next(d for d in range(1, 12) if (n + d) % 12 in scale)
        down = next(d for d in range(1, 12) if (n - d) % 12 in scale)
        if direction == 1 or (direction == 0 and up <= down):
            note.number = min(n + up, 131)
        else:
            note.number = max(n - down, 0)
