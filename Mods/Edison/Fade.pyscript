# FLPTools mod pack
from enveditor import *
import math


def createDialog():
    form = ScriptDialog('Fade', 'Fades the selection in or out with a shaped curve.')
    form.AddInputCombo('Direction', 'Fade in,Fade out,In and out', 0)
    form.AddInputCombo('Curve', 'Linear,Exponential,Logarithmic,S-curve', 3)
    form.AddInputKnob('In/out length (%)', 25, 1, 50)
    return form


def shape(x, curve):
    if curve == 1:
        return x * x
    if curve == 2:
        return math.sqrt(x)
    if curve == 3:
        return 0.5 - 0.5 * math.cos(math.pi * x)
    return x


def apply(form):
    x1 = Editor.SelectionStartS
    x2 = Editor.SelectionEndS
    if x2 <= x1:
        x1, x2 = 0, EditorSample.Length - 1
    direction = form.GetInputValue('Direction')
    curve = form.GetInputValue('Curve')
    edge = max(1, int((x2 - x1) * form.GetInputValue('In/out length (%)') / 100))
    total = max(1, x2 - x1)
    for n in range(x1, x2 + 1):
        if n % 20000 == 0:
            Utils.ProgressMsg('Fading', n - x1, total)
        pos = (n - x1) / total
        if direction == 0:
            g = shape(pos, curve)
        elif direction == 1:
            g = shape(1 - pos, curve)
        else:
            k = n - x1
            g = min(1.0, k / edge, (x2 - n) / edge)
            g = shape(max(0.0, g), curve)
        for c in range(EditorSample.NumChans):
            EditorSample.SetSampleAt(n, c, EditorSample.GetSampleAt(n, c) * g)
